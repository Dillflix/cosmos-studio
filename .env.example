# Control plane
COSMOS_STUDIO_BACKEND=mock
COSMOS_STUDIO_API_KEY=replace-with-a-long-random-value
COSMOS_STUDIO_PORT=8000
COSMOS_STUDIO_MAX_UPLOAD_MIB=1024
COSMOS_STUDIO_GALLERY_LIMIT=100
LOG_LEVEL=INFO

# The default profile keeps complete pipelines on the 8060S.
COSMOS_STUDIO_DEVICE_PROFILE=amd_8060s
COSMOS_STUDIO_AUX_DEVICE=cuda:0
COSMOS_STUDIO_COSMOS_DEVICE=cuda:0
COSMOS_STUDIO_VACE_DEVICE=cuda:0
COSMOS_STUDIO_EXPECTED_AUX_NAME="Radeon 8060S"

# Model directories inside the container.
COSMOS_STUDIO_COSMOS_IMAGE_MODEL=/models/Cosmos3-Super-Text2Image-nf4
COSMOS_STUDIO_COSMOS_VIDEO_MODEL=/models/Cosmos3-Super
COSMOS_STUDIO_VACE_MODEL=/models/Wan2.1-VACE-14B-diffusers
COSMOS_STUDIO_COSMOS_SAFETY_CHECKER=true
COSMOS_STUDIO_SKIP_ALLOCATOR_WARMUP=true

# Experimental split VACE profile. Do not enable until the single-device path works.
# COSMOS_STUDIO_DEVICE_PROFILE=vace_split
# COSMOS_STUDIO_DENOISER_DEVICE=cuda:1
# COSMOS_STUDIO_EXPECTED_DENOISER_NAME="RX 7900 XT"
# COSMOS_STUDIO_VACE_TRANSFORMER_FILE=/models/vace-transformer.gguf

# Existing Cosmos structured-prompt upsampler.
PROMPT_UPSAMPLER_ENDPOINT_URL=
PROMPT_UPSAMPLER_MODEL_NAME=
PROMPT_UPSAMPLER_API_TOKEN=not-required
PROMPT_UPSAMPLER_TIMEOUT_SECONDS=300
PROMPT_CACHE_MAX=128

# Hugging Face/cache behavior
HF_XET_HIGH_PERFORMANCE=1
TOKENIZERS_PARALLELISM=false
TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=0
